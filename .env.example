# X-Raya — пример настроек. Скопировать в .env и заполнить нужное.
# Обязательных переменных нет: без ключей работает разбор запроса и генерация ссылок.
# Полное описание — docs/CONFIG.md

# ── модель: включает разбор запроса и подборки Candy ──
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=openai/gpt-4o-mini

# ── подборки ──
# Пароль на вкладку подборок. Пусто = вкладка открыта всем.
CANDY_PASSWORD=

# ── внешние сервисы (необязательно) ──
SERPER_KEY=
SIGNALHIRE_KEY=

# ── служебное ──
PORT=3000
# Пароль к странице метрик /stats и к диагностике /api/ai/diag.
STATS_TOKEN=
